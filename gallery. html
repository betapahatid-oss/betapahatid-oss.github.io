<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Galeri Kerjaan</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    header {
      background: blue;
      color: white;
      padding: 15px;
      text-align: center;
    }

    nav a {
      color: white;
      margin: 0 10px;
      text-decoration: none;
      font-weight: bold;
    }

    nav a:hover {
      text-decoration: underline;
    }

    main {
      padding: 20px;
      text-align: center;
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 15px;
      margin-top: 20px;
    }

    .gallery .item {
      border: 1px solid #ddd;
      border-radius: 8px;
      overflow: hidden;
      background: #f9f9f9;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      cursor: pointer;
      transition: transform 0.2s;
    }

    .gallery .item:hover {
      transform: scale(1.05);
    }

    .gallery img {
      width: 100%;
      height: auto;
      display: block;
    }

    .gallery p {
      margin: 10px 0;
      font-weight: bold;
    }

    /* Popup background */
    .popup {
      display: none;
      position: fixed;
      z-index: 1000;
      padding-top: 60px;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgba(0,0,0,0.9);
    }

    /* Gambar di popup */
    .popup-content {
      margin: auto;
      display: block;
      max-width: 80%;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.5);
    }

    /* Caption */
    #caption {
      margin: 20px auto;
      text-align: center;
      color: #ccc;
      font-size: 18px;
    }

    /* Tombol close */
    .close {
      position: absolute;
      top: 20px;
      right: 35px;
      color: #fff;
      font-size: 40px;
      font-weight: bold;
      cursor: pointer;
    }
    .close:hover {
      color: #f00;
    }

    /* Tombol navigasi */
    .prev, .next {
      cursor: pointer;
      position: absolute;
      top: 50%;
      padding: 16px;
      margin-top: -50px;
      color: white;
      font-weight: bold;
      font-size: 30px;
      user-select: none;
      transition: 0.3s;
    }

    .next {
      right: 20px;
    }
    .prev {
      left: 20px;
    }

    .prev:hover, .next:hover {
      color: #f00;
    }
  </style>
</head>
<body>
  <header>
    <h1>Galeri Kerjaan Saya</h1>
    <nav>
      <a href="index.html"><img src="img/icon/home1.svg" width="80" height="20"></a>
      <a href="gallery.html"><img src="img/icon/gallery1.svg" width="80" height="20"></a>
    </nav>
  </header>

  <main>
    <section class="gallery">
      <div class="item"><img src="img/document/kabel1.jpg" alt="Projek 1"><p>Projek 1</p></div>
      <div class="item"><img src="img/document/panekabel1.png" alt="Projek 2"><p>Projek 2</p></div>
      <div class="item"><img src="img/document/coring1.jpg" alt="Projek 3"><p>Projek 3</p></div>
      <div class="item"><img src="img/document/pembuanganwastafel1.jpg" alt="Projek 4"><p>Projek 4</p></div>
    </section>
  </main>

  <!-- Modal (popup image) -->
  <div id="popup" class="popup">
    <span class="close">&times;</span>
    <img class="popup-content" id="popupImg">
    <div id="caption"></div>

    <!-- Tombol Next/Prev -->
    <a class="prev">&#10094;</a>
    <a class="next">&#10095;</a>
  </div>

  <script>
    // Ambil elemen popup
    var popup = document.getElementById("popup");
    var popupImg = document.getElementById("popupImg");
    var captionText = document.getElementById("caption");
    var span = document.getElementsByClassName("close")[0];

    // Semua gambar di galeri
    var images = document.querySelectorAll(".gallery img");
    var currentIndex = 0;

    // Klik gambar → buka popup
    images.forEach(function(img, index) {
      img.addEventListener("click", function() {
        popup.style.display = "block";
        showImage(index);
      });
    });

    // Fungsi untuk menampilkan gambar berdasarkan index
    function showImage(index) {
      currentIndex = index;
      popupImg.src = images[index].src;
      captionText.innerHTML = images[index].alt;
    }

    // Tombol close
    span.onclick = function() {
      popup.style.display = "none";
    }

    // Tutup popup jika klik background hitam
    popup.onclick = function(e) {
      if (e.target === popup) {
        popup.style.display = "none";
      }
    }

    // Navigasi next/prev
    document.querySelector(".next").onclick = function() {
      currentIndex = (currentIndex + 1) % images.length;
      showImage(currentIndex);
    };

    document.querySelector(".prev").onclick = function() {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      showImage(currentIndex);
    };
  </script>
</body>
</html>